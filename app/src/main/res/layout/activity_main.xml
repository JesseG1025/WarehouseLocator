<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/theme_bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Renders the warehouse background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/geometric_background"
        android:alpha="0.50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Title is pulled out of card and anchored to the top of the screen -->
    <!-- Added layout_marginTop to push it further down from the top edge -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Warehouse Locator"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card only holds the item data, anchors to the bottom of tvTitle -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardItemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/theme_surface"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Text view for the item scan box-->
        <TextView
            android:id="@+id/tvItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:drawableStart="@drawable/ic_barcode"
            android:drawablePadding="10dp"
            android:text="Item: --"
            android:textColor="@color/theme_text"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:textSize="20sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Card that holds the item location data, anchors to the bottom of the item container right above it-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardItemLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/theme_surface"
        app:layout_constraintTop_toBottomOf="@id/cardItemContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fixed layout_width to match_parent so the border fills the screen -->
        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="10dp"
            android:text="Location: --"
            android:textColor="@color/theme_text"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:textSize="20sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Button to manually wipe the scan queue, pulled out of the card to blend into the background -->
    <!-- Anchors to the bottom of the location container -->
    <Button
        android:id="@+id/btnClear"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        app:backgroundTint="@color/theme_accent"
        android:textColor="@color/theme_bg_dark"
        app:cornerRadius="0dp"
        android:text="Clear scans"
        app:layout_constraintTop_toBottomOf="@id/cardItemLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Text view for status, pulled out of the card to blend into the background -->
    <!-- Anchors to the bottom of the clear button -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textAlignment="center"
        android:padding="16dp"
        android:text="Status: Ready to scan"
        android:textSize="18sp"
        android:textStyle="italic"
        android:textColor="@color/theme_text"
        app:layout_constraintTop_toBottomOf="@id/btnClear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to navigate to recent scans screen -->
    <Button
        android:id="@+id/btnRecentScans"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        app:backgroundTint="@color/theme_surface"
        android:textColor="@color/theme_text"
        app:cornerRadius="0dp"
        android:text="Recent Scans"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Text view for credits, pulled out of the card to blend into the background -->
    <!-- Anchors to the bottom of the recent scans button -->
    <TextView
        android:id="@+id/tvCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:text="Warehouse Locater Version 1.0 by Jesse G"
        android:textAlignment="center"
        android:textColor="@color/theme_text"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btnRecentScans"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>